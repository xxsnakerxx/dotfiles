[user]
	email = xxsnakerxx@gmail.com
	name = Dmitrii Kolesnikov

[core]
	autocrlf = input
  excludesfile = ~/.gitignore_global

[column]
  ui = auto

[branch]
  sort = -committerdate

[tag]
  sort = version:refname

[init]
  defaultBranch = main

[merge]
	conflictStyle = zdiff3

[diff]
  algorithm = histogram
  colorMoved = plain
  mnemonicPrefix = true
  renames = true

[push]
  default = simple
  autoSetupRemote = true
  followTags = true

[fetch]
  prune = true
  pruneTags = true
  all = true

[alias]
  branch-name = "!git branch --show-current"
	append = town append
	diff-parent = town diff-parent
	hack = town hack
	prepend = town prepend
	propose = town propose
	repo = town repo
	ship = town ship
	sync = town sync
	delete = town delete
	rename = town rename

  gone = "!f() { \
    git fetch --prune && \
    git worktree prune && \
    git for-each-ref --format='%(refname:short)|%(upstream:track)|%(worktreepath)' refs/heads \
      | awk -F'|' '$2 == \"[gone]\" && $3 == \"\" {print $1}' \
      | xargs -r git branch -D; \
  }; f"

[git-town]
	ship-delete-tracking-branch = false
